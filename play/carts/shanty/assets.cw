-- Pirate Treasure art. The first palette is the text palette: text(..., "w"), ui colours, rect colours.
palette main
  . clear
  k #1a1c2c ink
  w #f4f4f4 white
  s #ffcd75 skin
  r #b13e53 red
  n #29366f navy
  o #8f563b brown
  y #ffe45c gold
  c #ef7d57 orange
  d #ab3428 crabdark
  a #f6d7a1 sand
  t #d1a05c sandshade
  u #3b5dc9 water
  v #41a6f6 foam
  m #566c86 stone
  l #94b0c2 stonelight

-- ---------- pirate hero (faces right; the kit flips it for left) ----------
sprite pirate1 16x16 pal=main
