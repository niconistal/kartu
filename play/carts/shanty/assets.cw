-- ---------- the island: 20x15 tiles; row 0 sits under the HUD ----------
map island 20x15
legend # water  , sand  ^ rock  V ship
legend P @hero:sand  * @chest:sand  C @crab:sand  B @parrot:sand
####################
#,,,,,,,,,,,,,,,,,,#
#,,,,,,,,,,,,,,,*,,#
#,,,,,,,,,,,,,,,,,,#
#,,,,^^,,,,,,,,,,,,#
#,,,,,,,,,,,,,,,,,,#
#,P,B,,,,,,,,,,,,,,#
#,,,,,,,,,*,,,,,,,V#
#,,,,,,,,,,,,,,,,,,#
#,,,,,,,,,,,^^,,,,,#
#,,,,,,,,,,,,,,,,,,#
#,,,,,,,,,,,,,C,,,,#
#,,*,,,,,,,,,,,,C,,#
#,,,,,,,,,,,,,,,,,,#
####################

-- ---------- audio ----------
instrument squeeze from=organ vibrato=0.35,5.5

song shanty bpm=126
  lead  @squeeze o5 l4 [a g f e | f g a b | a g f e | d e f g | f a >c <a | g e c e | g a b >d | <c b a2]2
  harm  @epiano v9 o4 l2 [a c | g b | a c | e g | f a | c e | g b | a c]2
  bass  @bass o2 l2 [a a | g g | a a | e e | f f | c c | g g | a a]2
  drums @drums [k8 h8 s8 h8 k8 h8 s8 h8]16

sfx treasure notes="o5 l16 c e g >c e g >c4" inst=bell vol=0.85 bpm=160
